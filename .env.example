# The upstream OpenAI-compatible image API, for example your chatgpt2api service.
ASTROGATE_UPSTREAM_URL=http://127.0.0.1:21873
ASTROGATE_UPSTREAM_API_KEY=replace-with-an-upstream-api-key

# Optional application settings
ASTROGATE_DATA_DIR=./data
ASTROGATE_COOKIE_SECURE=false

# Initial operator account; both values are required to create it.
ASTROGATE_ADMIN_USERNAME=
ASTROGATE_ADMIN_PASSWORD=
# New users start with 0 credits. 1 credit = 1 generated image.
ASTROGATE_SIGNUP_CREDITS=0

# Registration verification email. The deployed host uses its local Postfix.
ASTROGATE_SMTP_HOST=127.0.0.1
ASTROGATE_SMTP_PORT=25
# none for trusted local SMTP, starttls for port 587, ssl for port 465.
ASTROGATE_SMTP_SECURITY=none
ASTROGATE_SMTP_SENDER=noreply@astrogate.sbs
ASTROGATE_SMTP_USERNAME=
ASTROGATE_SMTP_PASSWORD=
# Optional persistent HMAC secret; generated in the data directory if left blank.
ASTROGATE_EMAIL_CODE_SECRET=
